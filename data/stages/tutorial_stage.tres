[gd_resource type="Resource" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/data/stage_definition.gd" id="1_stage"]
[ext_resource type="Script" path="res://scripts/data/wave_definition.gd" id="2_wave"]
[ext_resource type="Script" path="res://scripts/data/unit_spawn_definition.gd" id="3_spawn"]

[sub_resource type="Resource" id="Spawn1"]
script = ExtResource("3_spawn")
archetype_id = &"shield_guard"
owner_team_id = &"veil"
visual_faction_id = &"veil"
lane_id = &"front"

[sub_resource type="Resource" id="Spawn2"]
script = ExtResource("3_spawn")
archetype_id = &"archer"
owner_team_id = &"veil"
visual_faction_id = &"veil"
lane_id = &"front"

[sub_resource type="Resource" id="Spawn3"]
script = ExtResource("3_spawn")
archetype_id = &"assassin"
owner_team_id = &"veil"
visual_faction_id = &"veil"
lane_id = &"front"

[sub_resource type="Resource" id="Spawn4"]
script = ExtResource("3_spawn")
archetype_id = &"priest"
owner_team_id = &"veil"
visual_faction_id = &"veil"
lane_id = &"front"

[sub_resource type="Resource" id="Wave1"]
script = ExtResource("2_wave")
wave_number = 1
spawns = [SubResource("Spawn1")]

[sub_resource type="Resource" id="Wave2"]
script = ExtResource("2_wave")
wave_number = 2
spawns = [SubResource("Spawn2")]

[sub_resource type="Resource" id="Wave3"]
script = ExtResource("2_wave")
wave_number = 3
spawns = [SubResource("Spawn3")]

[sub_resource type="Resource" id="Wave4"]
script = ExtResource("2_wave")
wave_number = 4
spawns = [SubResource("Spawn4")]

[resource]
script = ExtResource("1_stage")
stage_id = &"tutorial_stage"
tutorial_stage = true
waves = [SubResource("Wave1"), SubResource("Wave2"), SubResource("Wave3"), SubResource("Wave4")]
