{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omenward/skill-registry-v3.schema.json",
  "title": "Omenward Skill Registry v3",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "base_source",
    "shared_contract",
    "routing",
    "selected_disciplines",
    "skills"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "project": {"const": "Omenward"},
    "base_source": {
      "type": "object",
      "required": ["repository", "commit", "synced_on", "policy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "synced_on": {"type": "string", "format": "date"},
        "policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "shared_contract": {"type": "string", "pattern": "^skills/.+\\.md$"},
    "routing": {
      "type": "object",
      "required": [
        "strategy",
        "work_modes",
        "default_mode",
        "always_on",
        "review_stack",
        "max_primary_disciplines",
        "max_support_disciplines",
        "specialists_require_trigger",
        "manual_override_requires_registered_id"
      ],
      "properties": {
        "strategy": {"const": "automatic_trigger_routing"},
        "work_modes": {"type": "array", "const": ["PLAN", "BUILD", "REVIEW"]},
        "default_mode": {"enum": ["PLAN", "BUILD", "REVIEW"]},
        "always_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "minItems": 1},
        "review_stack": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "minItems": 2},
        "max_primary_disciplines": {"type": "integer", "minimum": 1, "maximum": 1},
        "max_support_disciplines": {"type": "integer", "minimum": 0, "maximum": 2},
        "specialists_require_trigger": {"const": true},
        "manual_override_requires_registered_id": {"const": true}
      },
      "additionalProperties": false
    },
    "selected_disciplines": {
      "type": "array",
      "items": {"type": "string", "pattern": "^discipline\\."},
      "uniqueItems": true,
      "minItems": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "path", "triggers", "depends_on", "priority"],
        "properties": {
          "id": {"type": "string", "pattern": "^(foundation|discipline|specialist)\\.[a-z0-9-]+$"},
          "category": {"enum": ["foundation", "disciplines", "specialists"]},
          "path": {"type": "string", "pattern": "^skills/(foundation|disciplines|specialists)/[^/]+/SKILL\\.md$"},
          "triggers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
