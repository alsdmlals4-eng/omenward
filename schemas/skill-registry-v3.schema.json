{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alsdmlals4-eng/Base/schemas/skill-registry-v3.schema.json",
  "title": "Base Project Skill Registry v3",
  "type": "object",
  "required": [
    "schema_version",
    "registry_role",
    "routing_policy",
    "human_presentation",
    "skills",
    "selected_disciplines",
    "discipline_entrypoints"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "registry_role": {
      "const": "project-skill-router-and-learning-index"
    },
    "base_sync": {
      "type": "object"
    },
    "routing_policy": {
      "type": "object",
      "required": [
        "load_all_skills",
        "default_selection",
        "automatic_selection",
        "user_skill_declaration_required",
        "require_trigger_match",
        "require_execution_report",
        "work_modes",
        "max_primary_discipline_skills",
        "max_foundation_skills",
        "exclude_statuses"
      ],
      "properties": {
        "load_all_skills": {
          "const": false
        },
        "default_selection": {
          "const": "automatic-trigger-match"
        },
        "automatic_selection": {
          "const": true
        },
        "user_skill_declaration_required": {
          "const": false
        },
        "require_trigger_match": {
          "const": true
        },
        "require_execution_report": {
          "const": true
        },
        "work_modes": {
          "type": "array",
          "const": [
            "PLAN",
            "BUILD",
            "REVIEW"
          ]
        },
        "max_primary_discipline_skills": {
          "type": "integer",
          "minimum": 1
        },
        "max_foundation_skills": {
          "type": "integer",
          "minimum": 1
        },
        "exclude_statuses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "legacy_extensions": {
      "type": "object"
    },
    "human_presentation": {
      "type": "object",
      "required": [
        "primary_reading_format",
        "publication_manifest",
        "generator",
        "source_of_truth",
        "markdown_summary"
      ],
      "properties": {
        "primary_reading_format": {
          "const": "PROJECT_SKILL_MAP.pdf"
        },
        "editable_derivative": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagram_directory": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_manifest": {
          "const": "SKILL_MAP_PUBLICATION_MANIFEST.json"
        },
        "generator": {
          "type": "string"
        },
        "source_of_truth": {
          "const": "SKILL_REGISTRY.json"
        },
        "markdown_summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill_id",
          "layer",
          "discipline",
          "path",
          "status",
          "load_by_default",
          "trigger_tags",
          "use_when",
          "do_not_use_when",
          "learning_log"
        ],
        "properties": {
          "skill_id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "foundation",
              "specialist",
              "discipline"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^skills/.+/SKILL\\.md$"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "SUPPORT",
              "HOLD",
              "BACKUP",
              "REMOVAL_CANDIDATE"
            ]
          },
          "load_by_default": {
            "const": false
          },
          "trigger_tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "use_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "do_not_use_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "selected_disciplines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "discipline_entrypoints": {
      "type": "object"
    },
    "skill_contract_example": {
      "type": "object"
    },
    "required_disciplines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Deprecated Omenward generator compatibility alias; must equal selected_disciplines."
    }
  },
  "additionalProperties": true
}
